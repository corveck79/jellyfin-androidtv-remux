<?xml version="1.0" encoding="utf-8"?>
<!--
    Item details header, laid out like the web client (ElegantFin): centered
    image, title, meta row and buttons, then the overview, then two cards
    (item facts on the left, source picker + media info on the right).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="60dp"
    android:paddingTop="56dp"
    android:paddingEnd="60dp"
    android:paddingBottom="24dp">

    <org.jellyfin.androidtv.ui.AsyncImageView
        android:id="@+id/mainImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:background="@drawable/shape_card"
        android:maxWidth="260dp"
        android:scaleType="centerInside"
        tools:srcCompat="@drawable/app_banner" />

    <TextView
        android:id="@+id/fdTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:maxLines="2"
        android:textSize="38sp"
        tools:text="16. Hail Mary" />

    <TextView
        android:id="@+id/fdSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="- Season 8" />

    <LinearLayout
        android:id="@+id/fdMainInfoRow"
        android:layout_width="wrap_content"
        android:layout_height="20sp"
        android:layout_marginTop="6dp"
        android:dividerPadding="4sp"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/fdGenreRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha=".7"
        android:gravity="center"
        android:textSize="14sp"
        tools:text="Action / Drama" />

    <LinearLayout
        android:id="@+id/fdButtonRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:divider="@drawable/blank10x10"
        android:orientation="horizontal"
        android:showDividers="middle" />

    <org.jellyfin.androidtv.ui.ExpandableTextView
        android:id="@+id/fdSummaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:alpha=".85"
        android:ellipsize="end"
        android:fontFamily="sans-serif-light"
        android:maxLines="4"
        android:textSize="16sp"
        tools:text="The abduction and brutal torture of two college football stars puts SWAT on the trail of a violent drug dealer." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Left card: item facts -->
        <LinearLayout
            android:id="@+id/fdFactsCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/shape_detail_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/infoTitle1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:textSize="12sp"
                tools:text="Directed by" />

            <TextView
                android:id="@+id/infoValue1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha=".7"
                android:textSize="14sp"
                tools:text="Someone" />

            <TextView
                android:id="@+id/infoTitle2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textAllCaps="true"
                android:textSize="12sp"
                tools:text="Runs" />

            <TextView
                android:id="@+id/infoValue2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha=".7"
                android:textSize="14sp"
                tools:text="42m" />

            <TextView
                android:id="@+id/infoTitle3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textAllCaps="true"
                android:textSize="12sp"
                tools:text="Ends" />

            <TextView
                android:id="@+id/infoValue3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha=".7"
                android:textSize="14sp"
                tools:text="9:15 PM" />
        </LinearLayout>

        <!-- Right card: source picker + media info -->
        <LinearLayout
            android:id="@+id/fdSourceCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/shape_detail_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:id="@+id/fdSourcePicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_detail_select"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="10dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_guide"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/fdSourceText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="14sp"
                    tools:text="FHD S W A T (2017) S08 E16 WEB-DL AVC 2 GB 6.34 Mbps Torrentio" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:alpha=".7"
                    android:text="▾"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fdStreamPickers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/fdAudioPicker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/shape_detail_select"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_select_audio"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/fdAudioText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="13sp"
                        tools:text="English DD+ 5.1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fdSubtitlePicker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/shape_detail_select"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_select_subtitle"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/fdSubtitleText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="13sp"
                        tools:text="None" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/fdMediaInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="10dp"
                android:alpha=".7"
                android:textSize="14sp"
                tools:text="1080p H264 6.3 Mbps (Direct Play)" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
